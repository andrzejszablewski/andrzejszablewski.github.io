---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Replaces jekyll-sitemap's default sitemap (the plugin skips its own when this file exists, and still writes robots.txt).
  - The homepage shows the latest research updates, so its <lastmod> is the build time.
  - Other pages use `last_modified_at` from their front matter (or their `date`); update it when the page changes.
  - PDFs get no <lastmod>: GitHub Pages stamps every file with the build time, which would claim they all just changed.
  - Leave a page or collection out with `sitemap: false`.
{%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | where_exp: "p", "p.sitemap != false" | where_exp: "p", "p.url != '/404.html'" %}
{%- for p in pages %}
  <url>
    <loc>{{ p.url | replace: "/index.html", "/" | absolute_url | xml_escape }}</loc>
    {%- if p.url == "/" %}
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    {%- elsif p.last_modified_at or p.date %}
    <lastmod>{{ p.last_modified_at | default: p.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
{%- assign collections = site.collections | where_exp: "c", "c.output != false" %}
{%- for collection in collections %}
{%- assign docs = collection.docs | where_exp: "d", "d.sitemap != false" %}
{%- for d in docs %}
  <url>
    <loc>{{ d.url | absolute_url | xml_escape }}</loc>
    {%- if d.last_modified_at or d.date %}
    <lastmod>{{ d.last_modified_at | default: d.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
{%- endfor %}
{%- assign pdfs = site.static_files | where: "extname", ".pdf" | where_exp: "f", "f.sitemap != false" %}
{%- for f in pdfs %}
  <url>
    <loc>{{ f.path | absolute_url | xml_escape }}</loc>
  </url>
{%- endfor %}
</urlset>
